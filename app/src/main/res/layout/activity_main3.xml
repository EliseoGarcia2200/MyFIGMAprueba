<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco">

    <!-- Pestañas superiores: Local / Producto -->
    <LinearLayout
        android:id="@+id/tabsBusqueda"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_buscador"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tabLocal"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_buscador"
            android:backgroundTint="@color/blanco"
            android:gravity="center"
            android:text="Local"
            android:textColor="@color/texto_oscuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabProducto"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Producto"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Mapa de Google Maps -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapBusqueda"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@id/guidelineMapa"
        app:layout_constraintTop_toBottomOf="@id/tabsBusqueda" />

    <TextView android:id="@+id/tvMapaNoDisponible" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="78dp" android:paddingHorizontal="24dp"
        android:text="Consulta las panaderías en la lista. El mapa necesita una clave de Google Maps y los servicios de Google."
        android:textColor="@color/texto_secundario" android:textSize="14sp" android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/mapBusqueda" />

    <!-- Línea guía para dividir Mapa (arriba) y Lista de panaderías (abajo) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineMapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.65" />

    <!-- Contenedor flotante del buscador + lista de sugerencias -->
    <LinearLayout
        android:id="@+id/contenedorBuscadorMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:elevation="6dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="@id/mapBusqueda">

        <!-- Barra blanca con Lupa + EditText + X -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_buscador"
            android:backgroundTint="@color/blanco"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/btnBuscarLupa"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="2dp"
                android:src="@android:drawable/ic_menu_search" />

            <EditText
                android:id="@+id/etBuscarMapa"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Buscar panadería o calle..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnLimpiarBusqueda"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Vistas previas de lugares -->
        <ListView
            android:id="@+id/lvSugerenciasMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/blanco"
            android:elevation="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Lista de panaderías debajo del mapa -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLocales"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/guidelineMapa" />

    <TextView
        android:id="@+id/tvSinLocales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="Aún no hay panaderías con excedentes."
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/guidelineMapa" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
