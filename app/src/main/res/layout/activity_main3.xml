<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco">

    <!-- Toggle Local / Producto -->
    <LinearLayout
        android:id="@+id/toggleContainer"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_buscador"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tabLocal"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:text="Local"
            android:textColor="@color/texto_oscuro"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabProducto"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Producto"
            android:textColor="@color/texto_secundario" />
    </LinearLayout>

    <!-- Contenedor del Mapa Real + Buscador Flotante -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@id/rvLocales"
        app:layout_constraintTop_toBottomOf="@id/toggleContainer">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mapBusqueda"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <EditText
            android:id="@+id/etBuscarMapa"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_input"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:elevation="4dp"
            android:hint="Buscar panadería..."
            android:paddingHorizontal="14dp"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Lista inferior de panaderías -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLocales"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:clipToPadding="false"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

    <TextView
        android:id="@+id/tvSinLocales"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:textColor="@color/texto_secundario"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>