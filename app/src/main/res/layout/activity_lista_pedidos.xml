<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/blanco" android:orientation="vertical">
    <TextView android:id="@+id/tvTituloPedidos" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="20dp" android:textSize="24sp"
        android:textStyle="bold" android:textColor="@color/texto_oscuro" />
    <EditText android:id="@+id/etFiltroPedidos" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_buscador" android:paddingHorizontal="16dp"
        android:inputType="text" android:singleLine="true" android:hint="Buscar producto, persona o estado"
        android:textColor="@color/texto_oscuro" android:textColorHint="@color/texto_secundario" android:textSize="16sp" />
    <TextView android:id="@+id/tvListaVacia" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="20dp" android:textSize="16sp"
        android:textColor="@color/texto_secundario" android:accessibilityLiveRegion="polite" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPedidos" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="20dp"
        android:clipToPadding="false" android:paddingBottom="20dp" />
    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
